    "store_desc_godlike": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltet die höchste Schwierigkeitsstufe (Göttlich) frei. Erfordert keine Sterne und gewährt sofortigen Zugriff auf alle Level."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlocks the final difficulty level (Godlike). It has no star requirement, and purchasing it gives instant access to all levels."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea el nivel final de dificultad (Divino). No requiere estrellas y su compra da acceso instantáneo a todos los niveles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Débloque le niveau de difficulté final (Divin). Il ne nécessite aucune étoile et son achat donne un accès instantané à tous les niveaux."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odblokowuje ostatni poziom trudności (Godlike). Nie ma on wymogu gwiazdek, a jego zakup daje natychmiastowy dostęp do wszystkich poziomów."
          }
        }
      }
    },
    "store_desc_unlock_stars": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhöht das Sternelimit um 60 Sterne (derzeit auf 15 Sterne begrenzt). Spiele, die 16 oder mehr Sterne erfordern, bleiben ohne diesen Kauf gesperrt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds 60 stars to the limit (currently limited to 15 stars). Games requiring 16 or more stars will remain locked without this purchase."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade 60 estrellas al límite (actualmente limitado a 15 estrellas). Los juegos que requieran 16 o más estrellas permanecerán bloqueados sin esta compra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute 60 étoiles à la limite (actuellement limitée à 15 étoiles). Les jeux nécessitant 16 étoiles ou plus resteront verrouillés sans cet achat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaje 60 gwiazdek do limitu (obecnie limit wynosi 15 gwiazdek). Gry wymagające 16 i więcej gwiazdek nie odblokują się bez tego zakupu."
          }
        }
      }
    },
    "store_family_sharing_included": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Familienfreigabe inklusive 👨‍👩‍👧‍👦"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Family Sharing Included 👨‍👩‍👧‍👦"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartir en familia incluido 👨‍👩‍👧‍👦"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partage familial inclus 👨‍👩‍👧‍👦"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzielenie z rodziną w cenie 👨‍👩‍👧‍👦"
          }
        }
      }
    },
    "store_footer_notice": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnements verlängern sich automatisch, sofern sie nicht mindestens 24 Stunden vor Ablauf gekündigt werden. Frühere Käufe können jederzeit wiederhergestellt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscriptions auto-renew unless cancelled at least 24 hours before period end. Legacy purchases can be restored at any time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las suscripciones se renuevan automáticamente salvo cancelación al menos 24 horas antes del final del periodo. Las compras anteriores se pueden restaurar en cualquier momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les abonnements se renouvellent automatiquement sauf résiliation au moins 24h avant la fin de la période. Les achats antérieurs peuvent être restaurés à tout moment."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Subskrypcja odnawia się automatycznie, chyba że zostanie anulowana co najmniej 24 godziny przed końcem okresu. Poprzednie zakupy można przywrócić w dowolnym momencie."
          }
        }
      }
    },
    "store_intro_once_notice": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur einmalig für neue Abonnenten verfügbar. Nach dem Einführungszeitraum gilt der reguläre Verlängerungspreis."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available only once for new subscribers. Reverts to standard renewal price after intro period."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponible solo una vez para nuevos suscriptores. Vuelve al precio de renovación estándar después del período de oferta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponible une seule fois pour les nouveaux abonnés. Tarif de renouvellement standard après la période d'essai."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Promocja dostępna tylko raz dla nowych subskrybentów. Po okresie promocyjnym obowiązuje cena standardowa."
          }
        }
      }
    },
